# Build #2: Missed Lead SMS Re-Engagement Bot
# Environment Variables Reference

# ================================================
# OPENAI
# ================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_SYSTEM_PROMPT=You are a friendly legal intake assistant...  # See prompts/system-prompt.md

# ================================================
# GOHIGHLEVEL
# ================================================
GHL_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxxxxxx
GHL_PIPELINE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
GHL_MISSED_CALL_STAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
GHL_HOT_REPLY_STAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
GHL_CALENDAR_ID=xxxxxxxxxxxxxxxxxxxxxxxx
GHL_CALENDAR_LINK=https://api.leadconnectorhq.com/widget/booking/your-calendar-link

# ================================================
# SLACK
# ================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX
SLACK_CHANNEL=#hot-leads
SLACK_ATTORNEY_USER_ID=UXXXXXXXXX

# ================================================
# ATTORNEY SMS ALERT
# ================================================
ATTORNEY_PHONE=+1XXXXXXXXXX
ATTORNEY_GHL_CONTACT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# ================================================
# LANGCHAIN / MEMORY
# ================================================
LANGCHAIN_MEMORY_TYPE=redis
REDIS_URL=redis://localhost:6379
REDIS_TTL_HOURS=48

# ================================================
# N8N WEBHOOKS
# ================================================
N8N_MISSED_CALL_WEBHOOK=https://your-n8n.com/webhook/ghl-missed-call
N8N_INBOUND_SMS_WEBHOOK=https://your-n8n.com/webhook/ghl-inbound-sms

# ================================================
# FIRM DETAILS (used in SMS messages)
# ================================================
FIRM_NAME=Johnson Law Firm
FIRM_PHONE=+15551234567
ASSISTANT_NAME=Alex
